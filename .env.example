# PostgreSQL bağlantısı (docker-compose.yml içindeki servisle eşleşir)
DATABASE_URL=postgresql+asyncpg://maps:maps@localhost:5432/maps_scraper

# Eşzamanlı çalışacak tarayıcı context sayısı (temkinli başlayın)
SCRAPE_CONCURRENCY=2

# Aksiyonlar arası bekleme aralığı (ms)
SCRAPE_DELAY_MIN_MS=1200
SCRAPE_DELAY_MAX_MS=3500

# false yaparsanız tarayıcı görünür açılır (hata ayıklama / manuel captcha çözme için)
HEADLESS=true

# Virgülle ayrılmış proxy URL'leri, örn: http://user:pass@host:port,http://user:pass@host2:port
# Boş bırakılırsa proxy kullanılmadan yerel IP ile çalışılır.
PROXY_LIST=

# Webapp giriş ekranı. AUTH_PASSWORD boş bırakılırsa webapp KİMSEYE açılmaz
# (güvenlik gereği fail-closed) -- production'da mutlaka güçlü bir parola verin.
AUTH_USERNAME=admin
AUTH_PASSWORD=
